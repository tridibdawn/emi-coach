{
  "name": "emi-coach",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint 'packages/**/*.ts' 'apps/mobile/src/**/*.{ts,tsx}' && yarn workspace @emi-coach/mobile lint",
    "typecheck": "node scripts/typecheck-packages.mjs && yarn workspace @emi-coach/mobile typecheck",
    "test": "yarn test:packages && yarn workspace @emi-coach/mobile test --watchAll=false",
    "test:packages": "vitest run",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps/mobile/src",
    "privacy-scan": "node scripts/privacy-scan.mjs && python3 scripts/privacy_scan_backend.py",
    "sqlite-conflicts": "node scripts/scan-sqlite-conflicts.mjs",
    "op-sqlite-config": "node scripts/check-op-sqlite-config.mjs",
    "sqlcipher-spike-security": "node scripts/scan-sqlcipher-spike-security.mjs",
    "backend:test": "cd backend && .venv/bin/pytest -q",
    "backend:lint": "cd backend && .venv/bin/ruff check . && .venv/bin/mypy app",
    "android:assemble": "yarn workspace @emi-coach/mobile android:assemble"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "dependency-cruiser": "^16.10.2",
    "eslint": "^8.57.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "op-sqlite": {
    "sqlcipher": true
  }
}
